{
  "name": "cogniverse-platform",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "db:start": "node scripts/db.mjs start",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "db:seed": "node scripts/db.mjs seed",
    "build:contracts": "pnpm --filter @cogniverse/contracts build",
    "dev:api": "pnpm --filter @cogniverse/api dev",
    "dev:web": "pnpm --filter @cogniverse/web dev",
    "test": "pnpm --filter @cogniverse/api test",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-content.mjs && node scripts/smoke-timeout.mjs"
  },
  "devDependencies": {
    "argon2": "0.44.0",
    "embedded-postgres": "16.13.0-beta.17",
    "pg": "8.16.3"
  }
}