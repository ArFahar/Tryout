{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "outDir": "dist", "rootDir": "src",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "sourceMap": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false, "useUnknownInCatchVariables": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
